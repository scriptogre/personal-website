---
import { getCollection } from 'astro:content';

const blogs = (await getCollection('blogs')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latestBlog = blogs[0];

const { class: classList } = Astro.props;
---
{latestBlog && (
  <a href={`/blogs/${latestBlog.id}`} class:list={[classList, "ml-3 text-xs leading-5 font-medium text-red-800 dark:text-amber-500 bg-red-800/10 dark:bg-amber-500/20 rounded-full py-1 px-3 items-center interact:bg-red-800/20 dark:interact:bg-amber-500/40 duration-200"]}>
    <strong class="font-semibold">
      New Blog: {latestBlog.data.title}
    </strong>
    <iconify-icon icon="material-symbols:chevron-right" class="ml-2 translate-y-[1px]" />
  </a>
)}