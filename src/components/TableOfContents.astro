---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  class?: string;
  headings: Heading[];
}

const { class: classList, headings = [] } = Astro.props;

const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 4);
const minDepth = tocHeadings.length > 0 ? Math.min(...tocHeadings.map(h => h.depth)) : 2;
---

{tocHeadings.length > 0 && (
<nav
  id="page-outline"
  aria-label="Table of Contents"
  class:list={[classList]}
  _={`def setupTOC()
      wait 50ms
      js(me)
        if (me._tocObserver) me._tocObserver.disconnect()
        const headings = document.querySelectorAll('main h2[id], main h3[id], main h4[id]')
        const observer = new IntersectionObserver(
          (entries) => entries.forEach(entry => {
            if (entry.isIntersecting) {
              document.querySelectorAll('.toc-link').forEach(el => el.removeAttribute('data-active'))
              const link = document.querySelector('.toc-link[href="#' + entry.target.id + '"]')
              if (link) link.setAttribute('data-active', '')
            }
          }),
          { rootMargin: '-100px 0px -66% 0px', threshold: 0 }
        )
        headings.forEach(h => observer.observe(h))
        me._tocObserver = observer
      end
    end
    init call setupTOC() end
    on htmx:after:swap from document call setupTOC() end`}
>
  <h2 class="text-[0.675rem] font-sans tracking-wide uppercase text-neutral-500 mb-2 pb-2">
    On this page
  </h2>

  <div class="border-l border-neutral-150/60 dark:border-neutral-850/60">
    {tocHeadings.map((heading) => {
      const depth = heading.depth - minDepth;
      const indentClass = depth === 0 ? 'pl-4' : depth === 1 ? 'pl-8' : 'pl-12';

      return (
        <a
          href={`#${heading.slug}`}
          data-depth={depth}
          class={`toc-link block py-2.5 pr-3 text-sm truncate -ml-px border-l
            ${indentClass}
            border-transparent text-neutral-600 interact:text-neutral-900 interact:border-neutral-300/70
            dark:text-neutral-400 dark:interact:text-neutral-200 dark:interact:border-neutral-700/70
            data-[active]:border-neutral-500 data-[active]:text-neutral-900 data-[active]:font-semibold
            data-[active]:dark:border-neutral-500 data-[active]:dark:text-neutral-100
          `}
        >
          {heading.text}
        </a>
      );
    })}
  </div>
</nav>
)}
