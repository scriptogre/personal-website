---
const { item } = Astro.props;
const hasChildren = item.children?.length > 0;
---

<li>
  {item.href ? (
    <>
      <a href={item.href} class="group flex items-center px-4 py-2 rounded-lg hover:bg-neutral-400/10 outline-none focus-visible:outline-red-800 dark:focus-visible:outline-amber-500 transition-colors duration-200">
        {item.icon && <span class:list={[item.icon.name, item.icon.classList]}></span>}
        <span set:html={item.label}></span>
        {item.isNew && <span class="scale-75 text-xs font-medium text-red-800 dark:text-amber-500 bg-red-800/10 dark:bg-amber-500/20 group-hover:bg-red-800/20 dark:group-hover:bg-amber-500/40 transition-colors duration-100 rounded-full px-2 py-1 ml-auto">New</span>}
      </a>
      {hasChildren && <ul class="flex flex-col *:text-sm ml-4 pl-2 mt-2 gap-2 border-l border-neutral-800/10 dark:border-neutral-400/10">
        {item.children.map(child => <Astro.self item={child} />)}
      </ul>}
    </>
  ) : hasChildren && (
    <>
      <label onkeydown="if (event.key === 'Enter' || event.key === ' ') event.target.click()" tabindex="0" class="peer select-none cursor-pointer flex items-center w-full px-4 py-2 rounded-lg hover:bg-neutral-400/10 outline-none focus-visible:outline-red-800 dark:focus-visible:outline-amber-500 transition-colors duration-200">
        {item.icon && <span class:list={[item.icon.name, item.icon.classList]}></span>}
        <span set:html={item.label}></span>
        <input type="checkbox" class="hidden peer" id={item.label} autocomplete="off" checked={item.open} />
        <span class="icon-[bi--chevron-down] text-xs ml-auto peer-checked:rotate-180 transition-transform duration-200"></span>
      </label>
      <ul class="hidden peer-has-[:checked]:flex *:text-sm overflow-y-auto flex-col ml-4 pl-2 mt-2 gap-2 border-l border-neutral-800/10 dark:border-neutral-400/10">
        {item.children.map(child => <Astro.self item={child} />)}
      </ul>
    </>
  )}
</li>
