---
import { getCollection } from "astro:content";

import Header from "@components/Header.astro";
import Sidebar from "@components/Sidebar.astro";

// Styles
import '../assets/css/input.css';

// Fonts (from Fontsource)
import '@fontsource-variable/geist';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';

const links = await getCollection('links');

const { title, description, keywords='', og_image='', hideSidebar=false } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, viewport-fit=cover" />
  <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)" />
  <meta name="generator" content={Astro.generator} />

  <!-- Title and description -->
  <title>{title || 'Christian Tanul / @scriptogre'}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta name="author" content="Christian Tanul" />
  <meta property="og:title" content={`${title} | Christian Tanul`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://christiantanul.com" />
  {og_image && <meta property="og:image" content={"https://christiantanul.com" + og_image} />}
  {keywords && <meta name="keywords" content={keywords} />}

  <slot name="after-open-graph-meta">
    <meta property="og:type" content="website" />
  </slot>

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>😎</text></svg>" />

  <!-- Web Component - <icon-iconify/> -->
  <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>

  <!-- HTMX 4.0 -->
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0-alpha6/dist/htmx.min.js"></script>

  <!-- Hyperscript -->
  <script src="https://unpkg.com/hyperscript.org@0.9.14"></script>

</head>

<body hx-boost:inherited="true" hx-swap:inherited="innerMorph" class="flex flex-col justify-between min-h-screen relative font-sans text-neutral-800 dark:text-neutral-300 bg-linear-to-br from-neutral-50 to-neutral-100 dark:from-neutral-930 dark:to-neutral-900">

<!-- Navigation -->
<Header class="fixed top-0 inset-x-0 z-30" sidebarOpenByDefault={!hideSidebar} />
<Sidebar />
<!-- Mobile backdrop -->
<label for="sidebar-toggle-mobile" class="lg:hidden fixed z-10 inset-0 top-(--header-height) invisible opacity-0 [html:has(#sidebar-toggle-mobile:checked)_&]:visible [html:has(#sidebar-toggle-mobile:checked)_&]:opacity-100 transition-opacity bg-black/50 cursor-pointer"></label>
<!-- Desktop backdrop (hero only, uses hyperscript since checkbox has no ID) -->
{hideSidebar && (
  <div class="hidden lg:block fixed z-10 inset-0 top-(--header-height) invisible opacity-0 [html:has(.sidebar-toggle-desktop_input:checked)_&]:visible [html:has(.sidebar-toggle-desktop_input:checked)_&]:opacity-100 transition-opacity bg-black/50 cursor-pointer"
       _="on click set checkbox to first <input/> in .sidebar-toggle-desktop then set checkbox.checked to false"></div>
)}

<!-- Main Content -->
<main class="mt-(--header-height) mx-auto w-full max-w-6xl px-4 sm:px-8 starting:opacity-0 transition-opacity">
  <slot />
</main>

<slot name="footer">
  <!-- Footer -->
  <footer class:list={["flex flex-col items-center justify-center mb-4 mt-16", !hideSidebar && "lg:ps-80"]}>
    <div class="flex items-center gap-1">
      {links.map((link) => (
        <a
          href={link.data.href}
          target={link.data.href.startsWith('http') ? '_blank' : undefined}
          rel={link.data.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="inline-grid place-items-center p-2 text-neutral-600 dark:text-neutral-400 interact:text-neutral-800 dark:interact:text-neutral-300 duration-200 outline-hidden focus-visible:outline-red-800 dark:focus-visible:outline-amber-500 rounded-lg"
          aria-label={link.data.label}
          title={link.data.value}>
          <iconify-icon icon={link.data.icon} />
        </a>
      ))}
    </div>

    <span class="text-xs text-neutral-700 dark:text-neutral-400 mt-4">Copyright © {new Date().getFullYear()} Christian Tanul</span>
  </footer>
</slot>

</body>
</html>

<style is:global>
    /* To avoid layout shift */
    iconify-icon {
        display: inline-block;
        width: 1em;
        height: 1em;
    }
</style>
