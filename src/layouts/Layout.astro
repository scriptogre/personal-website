---
import { getCollection } from "astro:content";

import TopNav from "@components/TopNav.astro";
import SideNav from "@components/SideNav.astro";

// Styles
import '../css/global.css';

// Fonts (from Fontsource)
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource-variable/sora';

let links = await getCollection('links');
let socials = links.filter((link) => link.data.type === 'social');

const { title, description, keywords='', og_image='' } = Astro.props;
const pageURL = new URL(Astro.url.pathname, 'https://tanulchristian.dev').href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, viewport-fit=cover" />
  <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#121718" media="(prefers-color-scheme: dark)" />
  <meta name="generator" content={Astro.generator} />

  <!-- Title and description -->
  <title>{title} | Christian Tanul</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={pageURL} />

  <!-- Open Graph -->
  <meta name="author" content="Christian Tanul" />
  <meta property="og:title" content={`${title} | Christian Tanul`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageURL} />
  {og_image && <meta property="og:image" content={"https://tanulchristian.dev" + og_image} />}
  {keywords && <meta name="keywords" content={keywords} />}

  <slot name="after-open-graph-meta">
    <meta property="og:type" content="website" />
  </slot>

  <!-- Favicon (dark & light mode) -->
  <link rel="icon" href="/favicon.svg" />

</head>

<body class="flex flex-col justify-between min-h-screen relative font-['Barlow'] text-neutral-800 dark:text-neutral-300 bg-gradient-to-br from-neutral-50 to-neutral-100 dark:bg-dark-gradient">

<!-- Navigation -->
<TopNav class="sticky top-0 z-30" />
<SideNav class="fixed top-0 -translate-x-full side-nav-open:translate-x-0 z-20 transition-transform duration-200 ease-out" />
<label id="side-nav-backdrop" for="side-nav-toggle" class="fixed z-10 top-0 left-0 invisible opacity-0 side-nav-open:visible side-nav-open:opacity-100 transition-[opacity,visibility] duration-200 bg-black/50 mt-[calc(4rem+1px)] w-screen h-screen cursor-pointer"></label>

<!-- Main Content -->
<main class="mx-auto w-full max-w-6xl px-4 sm:px-8">
  <slot />
</main>

<slot name="footer">
  <!-- Footer -->
  <footer class="flex flex-col items-center justify-center mb-4 mt-16">
    <div class="flex">
      {socials.map((link) => (
        <a
          href={link.data.href}
          class="inline-grid place-items-center p-2 text-neutral-600 hover:text-neutral-800 focus-visible:text-neutral-800 dark:text-neutral-400 dark:hover:text-neutral-300 dark:focus-visible:text-neutral-300 transition-colors duration-200 outline-none outline-1 focus-visible:outline-red-800 dark:focus-visible:outline-amber-500 rounded-lg"
          target="_blank"
          aria-label={link.data.label}>
          <span class={link.data.icon}></span>
        </a>
      ))}
    </div>

    <span class="text-xs text-neutral-700 dark:text-neutral-400 mt-4">Copyright © {new Date().getFullYear()} Christian Tanul</span>
  </footer>
</slot>

</body>
</html>
